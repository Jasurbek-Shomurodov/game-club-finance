NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required only for the scheduled Telegram daily-finance report.
CRON_SECRET=generate-a-header-safe-random-secret-of-at-least-16-characters
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Configure at least one complete target pair.
TELEGRAM_PIXEL_CHAT_ID=your-pixel-chat-id
TELEGRAM_PIXEL_CLUB_ID=your-pixel-club-uuid
TELEGRAM_MAIN_CHAT_ID=your-main-chat-id
TELEGRAM_MAIN_CLUB_ID=your-main-club-uuid
TELEGRAM_BUNKER_CHAT_ID=your-bunker-chat-id
TELEGRAM_BUNKER_CLUB_ID=your-bunker-club-uuid

# AI assistant page. Server-only; never prefix these with NEXT_PUBLIC_.
# ASSISTANT_PROVIDER: anthropic (default) or gemini.
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional model override (Claude default claude-opus-5-5; for Gemini, one paid model id).
# ASSISTANT_MODEL=claude-opus-5-5
# Free Gemini tier: Google may use these prompts, which include club finances.
# It walks the free model chain (3.8 Flash down to 2.5 Flash-Lite) as quotas run
# out and is refused unless ASSISTANT_ALLOW_FREE_GEMINI=true.
# GEMINI_API_KEY=your-gemini-api-key
# ASSISTANT_ALLOW_FREE_GEMINI=false

# Optional public site on its own domain (src/lib/publicSite.ts). Leave unset
# and every host serves the admin app. See docs/runbooks/public-domain.md.
# PUBLIC_SITE_HOSTS=pixelgaming.uz,www.pixelgaming.uz
# PUBLIC_SITE_BRAND_SLUG=pixel-gaming
# ADMIN_SITE_URL=https://admin.pixelgaming.uz
